<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon, 夜幕 (night), API 26+: the Narwhal (#4D6BFE) on a
     fully transparent background. The foreground is the raster Narwhal
     (mipmap-*/ic_launcher_night_foreground.png); the monochrome layer is its white silhouette for themed icons.
     All four 桌面图标 styles are one drawing, so these files differ only in the layer they name. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/transparent" />
    <foreground android:drawable="@mipmap/ic_launcher_night_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>